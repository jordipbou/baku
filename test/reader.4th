\ KLambda reader tests.
\
\ The corpus tests read the real vendored Shen 43.2 files, not toy copies.  The
\ expected name list is generated by tools/klambda_expected.py, an independent
\ string-aware parser; this test compares the two sets.

[DEFINED] gforth
[IF]
	S" ../4th/baku.4th" INCLUDED
[ELSE]
	S" 4th/baku.4th" INCLUDED
[THEN]

: check ( flag code -- )
	swap if drop else ." BAKU-TEST-FAIL: " . cr abort then ;

: assert-true ( flag -- )
	if else ." BAKU-TEST-FAIL: expected true" cr abort then ;

: assert= ( actual expected -- )
	2dup = if 2drop else
		." BAKU-TEST-FAIL: got " . ." expected " . cr abort
	then ;

\ ---------------------------------------------------------------------------
\ Structural equality, copying a form out of scratch, and a test-local writer
\ ---------------------------------------------------------------------------

variable eqa
variable eqb

: string= ( a b -- flag )
	eqb ! eqa !
	eqa @ baku-string-length eqb @ baku-string-length <> if false exit then
	eqa @ baku-string-length 0 ?do
		eqa @ i baku-string@ eqb @ i baku-string@ <> if false unloop exit then
	loop true ;

: value= ( a b -- flag )
	2dup = if 2drop true exit then
	over baku-string? over baku-string? and if 2dup string= exit then
	over baku-cons? over baku-cons? and if
		2dup baku-hd >r baku-hd r> recurse
		if
			baku-tl swap baku-tl swap recurse
		else
			2drop false
		then
		exit
	then
	over baku-float? over baku-float? and if
		over baku-float@ swap baku-float@ f~ nip exit
	then
	2drop false ;

: copy-value ( v -- v' )
	dup baku-fixnum? if exit then
	dup baku-nil = if exit then
	dup baku-true = if exit then
	dup baku-false = if exit then
	dup baku-symbol? if exit then
	dup baku-string? if
		dup baku-string-addr swap baku-string-length baku-string exit
	then
	dup baku-float? if baku-float@ baku-float exit then
	dup baku-cons? if
		dup baku-hd recurse
		swap baku-tl recurse
		baku-cons exit
	then ;

8192 constant out-max
create out-buf out-max allot
variable out-len

: out-reset ( -- ) 0 out-len ! ;
: out-c ( c -- )
	out-len @ out-max >= if ." BAKU-TEST-FAIL: writer overflow" cr abort then
	out-buf out-len @ + c!
	out-len @ 1+ out-len ! ;
: out-type ( c-addr u -- ) 0 ?do dup i + c@ out-c loop drop ;
: out-str ( -- c-addr u ) out-buf out-len @ ;

: n>str ( n -- c-addr u ) dup abs 0 <# #s rot sign #> ;

: print-value ( v -- )
	dup baku-fixnum? if baku-fixnum-value n>str out-type exit then
	dup baku-nil = if drop s" ()" out-type exit then
	dup baku-true = if drop s" true" out-type exit then
	dup baku-false = if drop s" false" out-type exit then
	dup baku-symbol? if
		dup baku-symbol-name-addr swap baku-symbol-name-len out-type exit
	then
	dup baku-string? if
		[char] " out-c
		dup baku-string-addr over baku-string-length out-type
		[char] " out-c drop exit
	then
	dup baku-cons? if
		[char] ( out-c
		begin
			dup baku-cons?
		while
			dup baku-hd recurse
			baku-tl
			dup baku-cons? if bl out-c then
			dup baku-nil = if drop [char] ) out-c exit then
		repeat
		drop [char] ) out-c exit
	then
	drop s" ?" out-type ;

\ ---------------------------------------------------------------------------
\ Iterative tree walk: the largest stlib form is over 1 MiB of conses and
\ deeper than a small default test stack wants to recurse, so use a vector.
\ ---------------------------------------------------------------------------

1024 constant walk-max
variable walk-stack
variable walk-len
variable bs
variable trap
variable lit-a
variable lit-u

: obj-string= ( obj c-addr u -- flag )
	lit-u ! lit-a !
	dup baku-string-addr over baku-string-length
	lit-a @ lit-u @ baku-token= nip ;

: walk-push ( v -- )
	walk-len @ walk-max >= if ." BAKU-TEST-FAIL: walk stack overflow" cr abort then
	walk-stack @ walk-len @ baku-vector!
	walk-len @ 1+ walk-len ! ;

: walk-pop ( -- v )
	walk-len @ 1- dup walk-len !
	walk-stack @ swap baku-vector@ ;

: walk-count ( v -- )
	walk-push
	begin
		walk-len @ 0>
	while
		walk-pop
		dup baku-string? if
			dup baku-string-length 1 = if
				dup 0 baku-string@ 92 = if 1 bs +! then
			then
			s" (defun fail () shen.fail!)" obj-string= if 1 trap +! then
		else
			dup baku-cons? if
				dup baku-hd walk-push
				baku-tl walk-push
			else
				drop
			then
		then
	repeat ;

\ ---------------------------------------------------------------------------
\ Corpus scan
\ ---------------------------------------------------------------------------

variable defun-sym
variable names
variable names-count
variable total-forms
variable total-defuns
variable total-strings
variable file-forms
variable file-defuns
variable file-strings
variable want-forms
variable want-defuns
variable current-name
variable expected-count
variable distinct
variable dups
variable dupsym
variable seen

1200 baku-vector names !
1024 baku-vector walk-stack !
S" defun" baku-intern defun-sym !

: add-name ( sym -- )
	names @ names-count @ baku-vector!
	names-count @ 1+ names-count ! ;

: corpus-file ( c-addr u want-forms want-defuns -- )
	want-defuns ! want-forms !
	0 file-forms ! 0 file-defuns ! 0 file-strings !
	baku-read-file
	begin
		baku-read-form
	while
		file-forms @ 1+ file-forms !
		dup baku-string? if 1 file-strings +! then
		dup baku-cons? if
			dup baku-hd defun-sym @ = if
				1 file-defuns +!
				dup baku-tl baku-hd add-name
			then
		then
		walk-count
	repeat drop
	baku-read-close
	file-forms @ total-forms +!
	file-defuns @ total-defuns +!
	file-strings @ total-strings +!
	file-forms @ want-forms @ assert=
	file-defuns @ want-defuns @ assert=
	file-forms @ file-defuns @ - file-strings @ assert= ;

: corpus ( -- )
	0 total-forms ! 0 total-defuns ! 0 total-strings ! 0 names-count !
	0 bs ! 0 trap !
	s" vendor/shen-43.2/klambda/core.kl" 68 68 corpus-file
	s" vendor/shen-43.2/klambda/declarations.kl" 12 12 corpus-file
	s" vendor/shen-43.2/klambda/dict.kl" 16 16 corpus-file
	s" vendor/shen-43.2/klambda/extension-expand-dynamic.kl" 11 10 corpus-file
	s" vendor/shen-43.2/klambda/extension-features.kl" 5 4 corpus-file
	s" vendor/shen-43.2/klambda/extension-launcher.kl" 13 12 corpus-file
	s" vendor/shen-43.2/klambda/extension-namespaces.kl" 12 11 corpus-file
	s" vendor/shen-43.2/klambda/extension-programmable-pattern-matching.kl" 17 16 corpus-file
	s" vendor/shen-43.2/klambda/extension-type-annotations.kl" 8 7 corpus-file
	s" vendor/shen-43.2/klambda/init.kl" 4 4 corpus-file
	s" vendor/shen-43.2/klambda/load.kl" 16 16 corpus-file
	s" vendor/shen-43.2/klambda/macros.kl" 32 32 corpus-file
	s" vendor/shen-43.2/klambda/prolog.kl" 97 97 corpus-file
	s" vendor/shen-43.2/klambda/reader.kl" 137 137 corpus-file
	s" vendor/shen-43.2/klambda/sequent.kl" 50 50 corpus-file
	s" vendor/shen-43.2/klambda/stlib.kl" 326 326 corpus-file
	s" vendor/shen-43.2/klambda/sys.kl" 119 119 corpus-file
	s" vendor/shen-43.2/klambda/t-star.kl" 53 53 corpus-file
	s" vendor/shen-43.2/klambda/toplevel.kl" 17 17 corpus-file
	s" vendor/shen-43.2/klambda/track.kl" 29 29 corpus-file
	s" vendor/shen-43.2/klambda/types.kl" 6 6 corpus-file
	s" vendor/shen-43.2/klambda/writer.kl" 28 28 corpus-file
	s" vendor/shen-43.2/klambda/yacc.kl" 48 48 corpus-file
	total-forms @ 1124 assert=
	total-defuns @ 1118 assert=
	total-strings @ 6 assert=
	names-count @ 1118 assert=
	bs @ 8 assert=
	trap @ 1 assert= ;

variable set-buckets
variable set-next
variable find-sym
variable ins-i
variable ins-addr
variable ins-old

1024 baku-vector set-buckets !
1200 baku-vector set-next !

: name-hash ( sym -- h )
	dup baku-symbol-name-addr swap baku-symbol-name-len baku-hash ;

: set-find ( sym -- flag )
	find-sym !
	find-sym @ name-hash set-buckets @ swap baku-vector@
	begin dup while
		dup 1- names @ swap baku-vector@ find-sym @ = if
			drop true exit
		then
		1- set-next @ swap baku-vector@
	repeat drop false ;

: set-insert ( i -- flag )
	ins-i !
	ins-i @ names @ swap baku-vector@ set-find if false exit then
	ins-i @ names @ swap baku-vector@ name-hash
	set-buckets @ swap baku-vector-addr ins-addr !
	ins-addr @ @ ins-old !
	ins-i @ 1+ ins-addr @ !
	ins-old @ set-next @ ins-i @ baku-vector!
	true ;

: build-set ( -- )
	0 distinct ! 0 dups ! baku-nil dupsym !
	names-count @ 0 ?do
		i set-insert if
			distinct @ 1+ distinct !
		else
			dups @ 1+ dups !
			names @ i baku-vector@ dupsym !
		then
	loop ;

: expected-names ( -- )
	s" test/expected-defuns.kl" baku-read-file
	0 expected-count !
	begin
		baku-read-form
	while
		dup baku-symbol? 0= if ." BAKU-TEST-FAIL: expected file is not symbols" cr abort then
		dup set-find 0= if ." BAKU-TEST-FAIL: missing defined name" cr abort then
		drop
		expected-count @ 1+ expected-count !
	repeat drop
	baku-read-close
	expected-count @ 1117 assert= ;

corpus
build-set
expected-names
distinct @ 1117 assert=
dups @ 1 assert=
dupsym @ s" min" baku-intern = assert-true

\ ---------------------------------------------------------------------------
\ Fixtures
\ ---------------------------------------------------------------------------

: read-one ( c-addr u -- v f ) baku-read-string baku-read-form ;

: form-count ( c-addr u -- n )
	baku-read-file
	0
	begin
		baku-read-form
	while
		drop 1+
	repeat drop
	baku-read-close ;

\ Representative forms: every form is copied out of scratch, printed by the
\ test writer, re-read, and compared structurally.
: roundtrip ( c-addr u -- )
	baku-read-file
	begin
		baku-read-form
	while
		copy-value
		out-reset
		dup print-value
		out-str baku-read-string
		baku-read-form drop
		value= assert-true
	repeat drop
	baku-read-close ;

s" test/fixtures/forms.kl" roundtrip

\ Strings: an embedded newline and a literal backslash, plus the empty string.
s" test/fixtures/strings.kl" baku-read-file
baku-read-form drop
dup baku-string-length 17 assert=
dup 8 baku-string@ 10 assert=
drop
baku-read-form drop
dup baku-string-length 10 assert=
dup 4 baku-string@ 92 assert=
drop
baku-read-form drop
dup baku-string-length 0 assert=
drop
baku-read-form 0= assert-true
baku-read-close

\ Numbers: 64-bit integers and the kernel's float literals.
s" test/fixtures/numbers.kl" baku-read-file
baku-read-form drop baku-fixnum-value 10000000000 assert=
baku-read-form drop baku-fixnum-value -1 assert=
baku-read-form drop baku-fixnum-value 0 assert=
baku-read-form drop baku-float@ 3.1415926535897e 0.000000000000001e f~ assert-true
baku-read-form drop baku-float@ 2.7182818284590002e 0.00000000000001e f~ assert-true
baku-read-form drop baku-float@ 0.70710678118651e 0.000000000000001e f~ assert-true
baku-read-form drop baku-float@ 0.0001e 0.000000000000001e f~ assert-true
baku-read-form 0= assert-true
baku-read-close

\ Comments: both forms are skipped; ';' and '#' remain symbols.
s" test/fixtures/comments.kl" form-count 6 assert=
s" test/fixtures/comments.kl" baku-read-file
baku-read-form drop dup baku-cons? assert-true baku-hd defun-sym @ = assert-true
baku-read-form drop dup baku-cons? assert-true baku-hd defun-sym @ = assert-true
baku-read-form drop dup baku-symbol? assert-true dup baku-symbol-name-addr swap baku-symbol-name-len s" ;" baku-token= assert-true
baku-read-form drop dup baku-symbol? assert-true dup baku-symbol-name-addr swap baku-symbol-name-len s" #" baku-token= assert-true
baku-read-form drop dup baku-symbol? assert-true dup baku-symbol-name-addr swap baku-symbol-name-len s" r#" baku-token= assert-true
baku-read-form drop dup baku-symbol? assert-true dup baku-symbol-name-addr swap baku-symbol-name-len s" n#->n" baku-token= assert-true
baku-read-form 0= assert-true
baku-read-close

s" test/fixtures/only-comments.kl" baku-read-file
baku-read-form 0= assert-true
baku-read-close

\ '_' is distinct from '-'.
S" shen.initialise-environment" read-one drop
S" shen.initialise_environment" read-one drop
= 0= assert-true
S" a_b" read-one drop
S" a-b" read-one drop
= 0= assert-true

\ ---------------------------------------------------------------------------
\ Errors and recovery
\ ---------------------------------------------------------------------------

0 seen !
s" test/fixtures/malformed.kl" baku-read-file
baku-read-form drop
' baku-read-form catch
dup baku-read-eof = assert-true
dup baku-read-line 2 >= assert-true
baku-read-col 0> assert-true
drop
baku-read-source-name s" test/fixtures/malformed.kl" baku-token= assert-true
baku-read-close

\ The reader is usable after an error.
S" 42" read-one drop baku-fixnum-value 42 assert=
S" )" baku-read-string ' baku-read-form catch baku-read-syntax = assert-true
S" (foo" baku-read-string ' baku-read-form catch baku-read-eof = assert-true

\ BAKU-READ-ALL streams forms and releases scratch after each callback.
variable all-count
: count-form ( v -- ) drop all-count @ 1+ all-count ! ;
S" (a) (b) (c)" baku-read-string
0 all-count !
' count-form baku-read-all
all-count @ 3 assert=

." BAKU-TEST-DONE" cr
